{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steloit.dev/contract/v1/frontmatter.schema.json",
  "title": "Steloit Template Frontmatter (v1)",
  "description": "YAML frontmatter schema for steloit prompt templates. All 8 keys are required; rubric_ref may be null unless role is critic or inspector.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "description",
    "role",
    "model_key",
    "signature",
    "version",
    "tags",
    "rubric_ref"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "kebab-case slug identifying the template"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "$ref": "#/$defs/role"
    },
    "model_key": {
      "type": "string",
      "minLength": 1,
      "description": "Key into models.json; resolved by the orchestrator at spawn time"
    },
    "signature": {
      "type": "string",
      "pattern": "^> \\*\\*[A-Z][a-z]+\\*\\* `[a-z0-9.-]+` · [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Literal signature header line written by the agent at the top of every artifact"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver; used by #428 dashboard for rollback tracking"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form metadata for dashboard list filtering; empty array allowed"
    },
    "rubric_ref": {
      "type": ["string", "null"],
      "description": "Slug pointing at a rubric YAML. Required (non-null) iff role is critic or inspector."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": { "enum": ["critic", "inspector"] }
        },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "rubric_ref": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  ],
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "planner",
        "critic",
        "builder",
        "shield",
        "inspector",
        "ranger",
        "sage",
        "refiner",
        "custom"
      ]
    }
  }
}
